# Server-only Clinic inquiry configuration. Never commit real values.
RESEND_API_KEY=
CLINIC_INBOX_EMAIL=
CLINIC_FROM_EMAIL=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# The production hostname is fixed in source; VERCEL_URL safely adds the current preview hostname.

# Payment and video delivery stay inactive until a reservable session is accepted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Future payment activation also requires a publishable key, a fixed Stripe price,
# a signed webhook, accepted written scope, a reservable session, and cancellation terms.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
