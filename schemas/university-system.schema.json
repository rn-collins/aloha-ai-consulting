{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aloha-ai-consulting.vercel.app/schemas/university-system.schema.json",
  "title": "Aloha AI University educational system",
  "description": "Canonical contracts for curriculum, evidence, tools, assessment, portfolio work, and credentials. A course may remain a catalog preview without these records, but enrollment-open delivery requires a valid system.",
  "type": "object",
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "records": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/course" },
          { "$ref": "#/$defs/module" },
          { "$ref": "#/$defs/lesson" },
          { "$ref": "#/$defs/assessment" },
          { "$ref": "#/$defs/source" },
          { "$ref": "#/$defs/link" },
          { "$ref": "#/$defs/tool" },
          { "$ref": "#/$defs/project" },
          { "$ref": "#/$defs/rubric" },
          { "$ref": "#/$defs/credential" }
          ,{ "$ref": "#/$defs/outcome" }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "date": { "type": "string", "format": "date" },
    "course": {
      "type": "object",
      "required": ["id", "type", "title", "status", "moduleIds", "outcomeIds", "assessmentIds", "projectIds", "sourceIds", "toolIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "course" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["design", "curriculum-preview", "enrollment-open", "enrollment-closed", "archived"] },
        "moduleIds": { "$ref": "#/$defs/ids" },
        "outcomeIds": { "$ref": "#/$defs/ids" },
        "assessmentIds": { "$ref": "#/$defs/ids" },
        "projectIds": { "$ref": "#/$defs/ids" },
        "sourceIds": { "$ref": "#/$defs/ids" },
        "toolIds": { "$ref": "#/$defs/ids" },
        "credentialId": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": true
    },
    "module": {
      "type": "object",
      "required": ["id", "type", "title", "courseId", "position", "lessonIds", "outcomeIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "module" },
        "title": { "type": "string", "minLength": 1 },
        "courseId": { "$ref": "#/$defs/id" },
        "position": { "type": "integer", "minimum": 1 },
        "lessonIds": { "$ref": "#/$defs/ids" },
        "outcomeIds": { "$ref": "#/$defs/ids" }
      },
      "additionalProperties": true
    },
    "lesson": {
      "type": "object",
      "required": ["id", "type", "title", "moduleId", "position", "outcomeIds", "sourceIds", "activityIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "lesson" },
        "title": { "type": "string", "minLength": 1 },
        "moduleId": { "$ref": "#/$defs/id" },
        "position": { "type": "integer", "minimum": 1 },
        "outcomeIds": { "$ref": "#/$defs/ids" },
        "sourceIds": { "$ref": "#/$defs/ids" },
        "activityIds": { "$ref": "#/$defs/ids" }
      },
      "additionalProperties": true
    },
    "assessment": {
      "type": "object",
      "required": ["id", "type", "title", "courseId", "assessmentType", "outcomeIds", "rubricId", "passingRule"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "assessment" },
        "title": { "type": "string", "minLength": 1 },
        "courseId": { "$ref": "#/$defs/id" },
        "assessmentType": { "enum": ["diagnostic", "knowledge-check", "scenario", "lab", "project", "capstone"] },
        "outcomeIds": { "$ref": "#/$defs/ids" },
        "rubricId": { "$ref": "#/$defs/id" },
        "passingRule": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["id", "type", "title", "url", "authority", "publisher", "publishedOrUpdated", "lastVerified"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "source" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "authority": { "enum": ["primary", "official", "peer-reviewed", "authoritative-secondary", "supplemental"] },
        "publisher": { "type": "string", "minLength": 1 },
        "publishedOrUpdated": { "$ref": "#/$defs/date" },
        "lastVerified": { "$ref": "#/$defs/date" },
        "supports": { "$ref": "#/$defs/ids" }
      },
      "additionalProperties": true
    },
    "link": {
      "type": "object",
      "required": ["id", "type", "label", "href", "destinationType", "lastVerified"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "link" },
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "minLength": 1 },
        "destinationType": { "enum": ["internal-resource", "external-primary-source", "external-reference", "download", "action"] },
        "lastVerified": { "$ref": "#/$defs/date" }
      },
      "additionalProperties": true
    },
    "tool": {
      "type": "object",
      "required": ["id", "type", "title", "capabilityLevel", "implementationStatus", "dataPath", "limitations", "lastTested"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "tool" },
        "title": { "type": "string", "minLength": 1 },
        "capabilityLevel": { "enum": ["local-instrument", "connected-research-tool", "governed-ai-workflow", "institutional-system"] },
        "implementationStatus": { "enum": ["planned", "prototype", "public-beta", "production", "archived"] },
        "dataPath": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "lastTested": { "$ref": "#/$defs/date" }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": ["id", "type", "title", "courseId", "brief", "deliverableIds", "rubricId", "evidenceRequirements"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "project" },
        "title": { "type": "string", "minLength": 1 },
        "courseId": { "$ref": "#/$defs/id" },
        "brief": { "type": "string", "minLength": 1 },
        "deliverableIds": { "$ref": "#/$defs/ids" },
        "rubricId": { "$ref": "#/$defs/id" },
        "evidenceRequirements": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      },
      "additionalProperties": true
    },
    "rubric": {
      "type": "object",
      "required": ["id", "type", "title", "criteria", "scoringMethod", "passingScore"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "rubric" },
        "title": { "type": "string", "minLength": 1 },
        "criteria": { "type": "array", "minItems": 1 },
        "scoringMethod": { "type": "string", "minLength": 1 },
        "passingScore": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": true
    },
    "credential": {
      "type": "object",
      "required": ["id", "type", "title", "courseId", "issuanceStatus", "requirements", "verificationMethod"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "credential" },
        "title": { "type": "string", "minLength": 1 },
        "courseId": { "$ref": "#/$defs/id" },
        "issuanceStatus": { "enum": ["planned", "manual", "verifiable"] },
        "requirements": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "verificationMethod": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "outcome": {
      "type": "object",
      "required": ["id", "type", "statement", "level"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "outcome" },
        "statement": { "type": "string", "minLength": 1 },
        "level": { "enum": ["understand", "apply", "analyze", "evaluate", "create"] }
      },
      "additionalProperties": true
    }
  }
}
