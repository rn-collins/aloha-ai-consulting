  "scope": "Deterministic, browser-local lexical screening of English-language U.S. health-product marketing copy against five visible review categories. The same rules apply regardless of product, channel, audience, or state.",
  "jurisdictionPolicyBoundary": "The labels identify general FDA, FTC, and state consumer-protection attention zones; they do not determine jurisdiction, product classification, legality, substantiation, premarket status, or state-law requirements.",
  "prohibitedInference": "A signal is not a violation, and no configured signal is not clearance, substantiation, approval, or evidence that no regulator or legal duty applies.",
  "decisionThreshold": {
    "requiredCaseAccuracy": 1,
    "requiredPerClassRecall": 1,
    "maximumUnexpectedCategoryFlags": 0,
    "maximumFalseClearances": 0,
    "requiredAbstentionAccuracy": 1
  },
