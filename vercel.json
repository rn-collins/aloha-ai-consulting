{
  "buildCommand": "npm run site:build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/services.html", "destination": "/services", "permanent": true },
    { "source": "/strategy.html", "destination": "/strategy", "permanent": true },
    { "source": "/intelligence.html", "destination": "/intelligence", "permanent": true },
    { "source": "/content.html", "destination": "/content", "permanent": true },
    { "source": "/legal-ai.html", "destination": "/legal-ai", "permanent": true },
    { "source": "/builds.html", "destination": "/builds", "permanent": true },
    { "source": "/methods.html", "destination": "/methods", "permanent": true },
    { "source": "/partners.html", "destination": "/partners", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true },
    { "source": "/terms.html", "destination": "/terms", "permanent": true },
    { "source": "/homepage-v2", "destination": "/", "permanent": true },
    { "source": "/homepage-v3", "destination": "/", "permanent": true },
    { "source": "/engagements.html", "destination": "/engagements", "permanent": true },
    { "source": "/build-your-team.html", "destination": "/build-your-team", "permanent": true },
    { "source": "/ai-native-coo.html", "destination": "/ai-native-coo", "permanent": true },
    { "source": "/launch-stack.html", "destination": "/launch-stack", "permanent": true },
    { "source": "/assessment", "destination": "/university/assessment", "permanent": true },
    { "source": "/university/services", "destination": "/services", "permanent": true },
    { "source": "/university/services/ai-strategy-sprint", "destination": "/strategy", "permanent": true },
    { "source": "/university/services/ongoing-advisory", "destination": "/strategy", "permanent": true },
    { "source": "/university/services/ai-governance-setup", "destination": "/strategy", "permanent": true },
    { "source": "/university/services/ai-implementation", "destination": "/services", "permanent": true },
    { "source": "/university/services/ai-workflow-design", "destination": "/services", "permanent": true }
  ],
  "rewrites": [
    { "source": "/services", "destination": "/services-v2" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://www.federalregister.gov https://aloha-dea-tracker.vercel.app https://courtlistener.com https://www.courtlistener.com; img-src 'self' data: https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://aloha-dea-tracker.vercel.app" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|woff|woff2|ttf|otf|eot)$",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|svg|ico|webp|avif)$",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
