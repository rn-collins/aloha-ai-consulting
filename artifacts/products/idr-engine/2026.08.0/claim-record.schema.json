{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aloha-ai.example/schemas/idr-claim-record/1.0",
  "title": "IDR claim record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "claim",
    "jurisdiction",
    "authority",
    "pinpoint",
    "retrievedAt",
    "confidence",
    "changeWatch",
    "humanReview",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "authorityType",
        "weight",
        "url",
        "binding"
      ],
      "properties": {
        "sourceId": {
          "type": "string"
        },
        "authorityType": {
          "type": "string"
        },
        "weight": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "binding": {
          "type": "boolean"
        }
      }
    },
    "pinpoint": {
      "type": "string",
      "minLength": 1
    },
    "retrievedAt": {
      "type": "string",
      "format": "date"
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "changeWatch": {
      "type": "object",
      "required": [
        "trigger",
        "cadence",
        "nextReview"
      ],
      "properties": {
        "trigger": {
          "type": "string"
        },
        "cadence": {
          "type": "string"
        },
        "nextReview": {
          "type": "string"
        }
      }
    },
    "humanReview": {
      "type": "object",
      "required": [
        "required",
        "status",
        "reviewer"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "status": {
          "enum": [
            "pending",
            "verified",
            "rejected"
          ]
        },
        "reviewer": {
          "type": "string"
        }
      }
    },
    "status": {
      "enum": [
        "hold",
        "verified-for-bounded-use",
        "rejected"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
