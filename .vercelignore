# Keep internal docs, governance notes, security policy, and non-build scripts out of the public deploy.
# The structured site generator must be uploaded because Vercel runs it during the build.
*.md
*.py
*.sh
.DS_Store
.gitignore
docs/
scripts/*
!scripts/build-site.js
!scripts/build-claim-registry.js
!scripts/hydrate-build-snapshots.js
