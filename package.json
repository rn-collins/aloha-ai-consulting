{
  "name": "aloha-ai-consulting",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "site:validate": "node scripts/build-site.js --validate",
    "site:build": "node scripts/build-site.js",
    "site:check": "node scripts/build-site.js --check",
    "site:html": "node scripts/validate-generated-html.js",
    "site:audit": "node scripts/audit-entire-site.js",
    "site:parity": "node scripts/audit-migration-parity.js",
    "site:restore-parity": "node scripts/restore-editorial-parity.js",
    "site:smoke": "node scripts/smoke-test.js",
    "site:test": "node --test tests/*.test.js",
    "site:ci": "npm run site:test && npm run site:validate && npm run site:build && npm run site:audit && npm run site:check && npm run site:html"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  },
  "engines": {
    "node": "24.x"
  }
}
